{
  "name": "clinical-onboarding",
  "private": true,
  "version": "0.1.0",
  "description": "Clinical Onboarding App — onboarding for counselling and therapy practices.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node server/index.mjs",
    "seed": "node server/seed.mjs",
    "test": "node --test 'test/*.test.mjs' && vitest run",
    "test:server": "node --test 'test/*.test.mjs'",
    "test:ui": "vitest run",
    "build": "tsc -b && vite build",
    "start": "node server/seed.mjs --if-empty && NODE_ENV=production node server/index.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "railway": "^3.13.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
